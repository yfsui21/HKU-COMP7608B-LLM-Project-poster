# Copy to .env.local and fill in. .env.local is gitignored and takes
# precedence over the inherited environment.
#
# Both routes point at whatever OpenAI-/Anthropic-compatible endpoint you use.
# Omit a BASE_URL to talk to the vendor's own API directly.

# Claude models (claude-*) go over the Anthropic Messages API.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# Everything else (qwen / gpt / doubao / gemini / ...) goes over the
# OpenAI-compatible Chat Completions API.
OPENAI_API_KEY=
OPENAI_BASE_URL=
